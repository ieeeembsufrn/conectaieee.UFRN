# ===========================================
# IEEE PROJECTHUB - ENVIRONMENT VARIABLES
# ===========================================

# ===== SUPABASE CONFIGURATION =====
# Configure your Supabase connection
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===== APP CONFIGURATION =====
# Basic app settings
VITE_APP_TITLE=IEEE ProjectHub
VITE_APP_VERSION=1.0.0
VITE_PUBLIC_APP_URL=https://unb.conectaieee.com

# ===== API CONFIGURATION =====
# Base URL for external APIs (if any)
VITE_API_BASE_URL=https://api.yourservice.com

# ===== SUPABASE EDGE FUNCTION SECRETS =====
# Configure these with `supabase secrets set ...`; they are not exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CF_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://assets.your-domain.com

# ===== DEVELOPMENT ONLY =====
# These are only used in development
NODE_ENV=production
